<odoo>

    <template id="report_expense_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <div class="page">

                    <!-- Header -->
                    <div style="text-align:center; border-bottom:2px solid #4CAF50; padding-bottom:10px; margin-bottom:15px;">
                        <h1 style="color:#4CAF50; font-size:26px; margin:0;">
                            Expense Report
                        </h1>
                        <p style="font-size:14px; color:#555; margin-top:5px;">
                            Detailed Record of All Expenses
                        </p>
                    </div>

                    <!-- Date Range -->
                    <div style="margin-bottom:15px; font-size:14px; color:#333;">
                        <p style="margin:0 0 5px 0;">
                            <strong>From:</strong>
                            <t t-esc="o.start_date"/>
                            <span style="margin-left:20px;"></span>
                            <strong>To:</strong>
                            <t t-esc="o.end_date"/>
                        </p>
                    </div>

                    <!-- Expense Details -->
                    <h3 style="color:#4CAF50; border-bottom:1px solid #ddd; padding-bottom:5px; margin-top:20px;">
                        Expense Details
                    </h3>

                    <table style="width:100%; border-collapse:collapse; margin-top:10px; font-size:14px;">
                        <thead>
                            <tr style="background-color:#f5f5f5;">
                                <th style="padding:8px; border:1px solid #ddd;">Date</th>
                                <th style="padding:8px; border:1px solid #ddd;">Expense Type</th>
                                <th style="padding:8px; border:1px solid #ddd; text-align:right;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="o.expense_lines">
                                <t t-foreach="o.expense_lines" t-as="line">
                                    <tr>
                                        <td style="padding:8px; border:1px solid #ddd;">
                                            <t t-esc="line.expense_date"/>
                                        </td>
                                        <td style="padding:8px; border:1px solid #ddd;">
                                            <t t-esc="line.expense_type_id.name if line.expense_type_id else ''"/>
                                        </td>
                                        <td style="padding:8px; border:1px solid #ddd; text-align:right;">
                                            <t t-esc="line.amount"/>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="3" style="padding:10px; border:1px solid #ddd; text-align:center; color:#777;">
                                        No expense records found for the selected date range.
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Summary -->
                    <h3 style="color:#4CAF50; border-top:1px solid #ddd; padding-top:10px; margin-top:20px;">
                        Summary Totals
                    </h3>

                    <table style="width:40%; border-collapse:collapse; margin-top:10px; font-size:14px;">
                        <tbody>
                            <tr>
                                <td style="padding:8px; border:1px solid #ddd;">
                                    Total Expenses
                                </td>
                                <td style="padding:8px; border:1px solid #ddd; text-align:right;">
                                    <t t-esc="o.total_expense_amount"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Footer -->
                    <div style="margin-top:30px; text-align:center; color:#888; font-size:12px;">
                        <p style="margin:0;">
                            Generated on
                            <t t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d %H:%M:%S')"/>
                        </p>
                        <p style="margin-top:5px;">
                            Powered by Pharmacy Management System
                        </p>
                    </div>

                </div>
            </t>
        </t>
    </template>

</odoo>