<?xml version="1.0" encoding="utf-8"?>
<odoo>
<!-- Module Category -->
    <record id="module_category_pharmacy" model="ir.module.category">
        <field name="name">Pharmacy Management</field>
        <field name="sequence" eval="10"/>
    </record>

    <!-- Pharmacy Manager Group -->
    <record id="group_pharmacy_manager" model="res.groups">
        <field name="name">Pharmacy Manager</field>
        <field name="category_id" ref="pharmacy.module_category_pharmacy"/>
    </record>

    <!-- Pharmacy Record Officer Group -->
    <record id="group_pharmacy_record_officer" model="res.groups">
        <field name="name">Pharmacy Record Officer</field>
        <field name="category_id" ref="pharmacy.module_category_pharmacy"/>
    </record>

    <!--    app menu visibility to specific group -->
    <record id="base.menu_management" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

    <!-- Discuss menu visible just for odoo Administrator user  -->
    <record id="mail.menu_root_discuss" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>

    <!-- Hr Employee Root menu visible just for odoo Administrator user  -->
    <record id="hr.menu_hr_root" model="ir.ui.menu">
        <field name="groups_id" eval="[(6, 0, [ref('base.group_erp_manager')])]"/>
    </record>


