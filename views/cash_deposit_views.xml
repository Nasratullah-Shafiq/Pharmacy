<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- TREE VIEW -->
    <record id="view_pharmacy_cash_deposit_tree" model="ir.ui.view">
        <field name="name">pharmacy.cash.deposit.tree</field>
        <field name="model">pharmacy.cash.deposit</field>
        <field name="arch" type="xml">
            <tree string="Cash Deposits">
                <field name="cash_account_id"/>
                <field name="account_type"/>
                <field name="amount" sum="Total"/>
                <field name="currency_type"/>
                <field name="date"/>
                <field name="user_id"/>
                <field name="note"/>
            </tree>
        </field>
    </record>

    <!-- FORM VIEW -->
    <record id="view_pharmacy_cash_deposit_form" model="ir.ui.view">
        <field name="name">pharmacy.cash.deposit.form</field>
        <field name="model">pharmacy.cash.deposit</field>
        <field name="arch" type="xml">
            <form string="Cash Deposit">
                <!-- HEADER -->
                <header>
                    <button name="action_deposit_done"
                            string="Mark as Deposit Done"
                            type="object"
                            class="btn-primary"
                            invisible="status != 'new_deposit'"/>

                    <field name="status"
                           widget="statusbar"
                           statusbar_visible="new_deposit,deposit_done"/>
                </header>

                <sheet>
                    <!-- RIBBONS -->
                    <widget name="web_ribbon"
                            title="New Deposit"
                            bg_color="bg-info"
                            invisible="status != 'new_deposit'"/>

                    <widget name="web_ribbon"
                            title="Deposit Done"
                            bg_color="bg-success"
                            invisible="status != 'deposit_done'"/>

                    <group>
                        <group string="Deposit Information">
                            <field name="account_type"/>
                            <field name="cash_account_id"
                                   domain="[('account_type', '=', account_type)]"/>

                            <field name="cashier_id"
                                   invisible="account_type != 'cashier'"/>
                            <field name="currency_type"/>
                            <field name="amount"/>
                            <field name="date"/>
                            <field name="user_id" readonly="1"/>
                        </group>

                        <group string="Notes">
                            <field name="note"/>
                        </group>
                    </group>
                </sheet>

                <!-- CHATTER -->
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <!-- SEARCH VIEW WITH SEARCH PANEL -->
    <record id="view_pharmacy_cash_deposit_search" model="ir.ui.view">
        <field name="name">pharmacy.cash.deposit.search</field>
        <field name="model">pharmacy.cash.deposit</field>
        <field name="arch" type="xml">
            <search string="Cash Deposits">

                <!-- Quick search fields -->
                <field name="cash_account_id"/>
                <field name="date"/>

                <!-- Search panel -->
                <searchpanel>
                    <field name="cash_account_id" string="Cash Account" icon="fa-briefcase"/>
                    <field name="currency_type" icon="fa-money"/>
                    <field name="deposit_year" string="Year" select="1" icon="fa-calendar"/>
                    <field name="deposit_month" string="Month" select="1" icon="fa-calendar"/>
                </searchpanel>

            </search>
        </field>
    </record>

    <!-- PIVOT VIEW -->
    <record id="view_pharmacy_cash_deposit_pivot" model="ir.ui.view">
        <field name="name">pharmacy.cash.deposit.pivot</field>
        <field name="model">pharmacy.cash.deposit</field>
        <field name="arch" type="xml">
            <pivot string="Cash Deposits Pivot">
                <field name="user_id" type="col"/>
                <field name="amount" type="measure"/>
                <field name="date" type="col"/>
            </pivot>
        </field>
    </record>

    <!-- GRAPH VIEW -->
    <record id="view_pharmacy_cash_deposit_graph" model="ir.ui.view">
        <field name="name">pharmacy.cash.deposit.graph</field>
        <field name="model">pharmacy.cash.deposit</field>
        <field name="arch" type="xml">
            <graph string="Cash Deposits Graph" type="bar">
                <field name="amount" type="measure"/>
                <field name="date" type="col"/>
            </graph>
        </field>
    </record>

    <!-- ACTION -->
    <record id="action_pharmacy_cash_deposit" model="ir.actions.act_window">
        <field name="name">Cash Deposits</field>
        <field name="res_model">pharmacy.cash.deposit</field>
        <field name="view_mode">tree,form,pivot,graph</field>
        <field name="search_view_id" ref="view_pharmacy_cash_deposit_search"/>
    </record>

    <!-- MENU ITEM -->
    <menuitem id="menu_pharmacy_cash_deposit"
              name="Cash Deposits"
              parent="menu_pharmacy_finance"
              action="action_pharmacy_cash_deposit"
              groups="pharmacy.group_pharmacy_manager"
              sequence="5"/>
</odoo>