<odoo>
    <!-- Wizard Form View -->
    <record id="view_pharmacy_cash_account_report_wizard_form" model="ir.ui.view">
        <field name="name">pharmacy.cash.account.report.wizard.form</field>
        <field name="model">pharmacy.cash.account.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Cash Account Report">
                <sheet>
                    <group>
                        <field name="account_type"/>
                    </group>

                    <group string="Totals By Currency">
                        <group>
                            <field name="total_afn" readonly="1"/>
                            <field name="total_usd" readonly="1"/>
                            <field name="total_kaldar" readonly="1"/>
                        </group>
                    </group>

                    <group string="Deposit Details">
                        <field name="deposit_lines"  readonly="1">
                            <tree>
                                <field name="date"/>
                                <field name="account_no"/>
                                <field name="account_type"/>
                                <field name="currency_type"/>
                                <field name="amount"/>
                                <field name="user_id"/>
                                <field name="note"/>
                            </tree>
                        </field>
                    </group>
                </sheet>

                <footer>
                    <button name="generate_report"
                            string="Generate Report"
                            type="object"
                            class="btn-primary"/>

                    <button name="print_pdf_report"
                            string="Print PDF"
                            type="object"
                            class="btn-secondary"/>

                    <button string="Close"
                            special="cancel"
                            class="btn-default"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_cash_account_report_wizard" model="ir.actions.act_window">
        <field name="name">Pharmacy Cash Account Report</field>
        <field name="res_model">pharmacy.cash.account.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pharmacy_cash_account_report_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_cash_account_report"
              name="Cash Account Report"
              parent="menu_finance_report"
              action="action_cash_account_report_wizard"
              sequence="25"/>
</odoo>
