<odoo>
    <record id="view_pharmacy_purchase_report_wizard" model="ir.ui.view">
        <field name="name">pharmacy.purchase.report.wizard.form</field>
        <field name="model">pharmacy.purchase.report</field>
        <field name="arch" type="xml">
            <form string="Pharmacy Purchase Report">
                <group>
                    <field name="start_date"/>
                    <field name="end_date"/>
                </group>

                <group string="Summary Totals">
                    <field name="total_quantity" readonly="1"/>
                    <field name="total_amount" readonly="1"/>
                </group>

                <group string="Purchase Details">
                    <field name="purchase_lines" string="" readonly="1">
                        <tree>
                            <field name="date"/>
                            <field name="product_type"/>
                            <field name="supplier_id"/>
                            <field name="quantity"/>
                            <field name="unit_price"/>
                            <field name="total"/>
                        </tree>
                    </field>
                </group>

                <footer>
                    <button string="Generate Report"
                            type="object"
                            name="generate_report"
                            class="btn-primary"/>

                    <button string="Print PDF"
                            type="object"
                            name="print_pdf_report"
                            class="btn-secondary"/>

                    <button string="Cancel"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_pharmacy_purchase_report_wizard" model="ir.actions.act_window">
        <field name="name">Pharmacy Purchase Report</field>
        <field name="res_model">pharmacy.purchase.report</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="view_pharmacy_purchase_report_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_pharmacy_purchase_report"
              name="Purchase Report"
              parent="menu_finance_reports"
              action="action_pharmacy_purchase_report_wizard"
              sequence="15"/>
</odoo>